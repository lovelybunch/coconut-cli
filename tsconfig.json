{
  // Deliberately self-contained (no @coco/config extends), matching coconut-sdk:
  // this package is designed to be liftable into its own repository without
  // edits (its only workspace tie is the coconut-sdk dependency).
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
